{
  "name": "pi-litellm",
  "version": "0.1.0",
  "private": true,
  "description": "LiteLLM proxy provider for pi: /login, model discovery, per-model transport",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "litellm"
  ],
  "license": "MIT",
  "author": "Artefactory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artefactory/pi-litellm.git"
  },
  "homepage": "https://github.com/artefactory/pi-litellm#readme",
  "bugs": {
    "url": "https://github.com/artefactory/pi-litellm/issues"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write --print-width 100 src tests README.md",
    "format:check": "prettier --check --print-width 100 src tests README.md"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.6.0",
    "@earendil-works/pi-coding-agent": ">=1.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "22.20.5",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
